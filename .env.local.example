# HomeSync environment.
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and must NEVER be committed.

# Neon serverless PostgreSQL connection string (Neon dashboard -> Connection Details).
# Use the pooled connection string; keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js (Google OAuth). Generate AUTH_SECRET with: openssl rand -base64 33
AUTH_SECRET=""
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated allowlist of the two Google account emails allowed to sign in.
ALLOWED_EMAILS="you@gmail.com,partner@gmail.com"

# Seed members for scripts/seed.mjs — comma-separated "Name:email" pairs.
SEED_MEMBERS="Jane:jane@gmail.com,Sam:sam@gmail.com"

# Outbound ICS calendar feed (app/api/calendar.ics) — generate with: openssl rand -hex 32
# Also set this in Vercel's environment settings; without it the feed 404s.
CALENDAR_FEED_TOKEN=""

# Calendar reminders + web push (app/api/reminders/run, lib/push.ts) — generate
# a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact URI the push service can reach you on, e.g. mailto:you@example.com
VAPID_SUBJECT=""
# The reminder sender route's own bearer token — generate with: openssl rand -hex 32
# Also set this in Vercel's environment settings, and give it to the external
# 5-minute pinger (e.g. cron-job.org) as an `Authorization: Bearer <value>` header.
CRON_SECRET=""

# Calendar attachments (app/api/attachments/upload) — auto-created when a Blob
# store is connected to this project in the Vercel dashboard (Storage tab).
# Pull it into .env.local with: vercel env pull
BLOB_READ_WRITE_TOKEN=""
